POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
# Replace with a strong local password before starting Compose.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
# For host-side CLI; replace password to match POSTGRES_PASSWORD, URL-encoding special characters.
DATABASE_URL=postgresql://marketplace:change-me@localhost:5432/marketplace
API_BASE_URL=http://localhost:8000
DAGSTER_PORT=3000
DASHBOARD_PORT=8501
DBT_SCHEMA=analytics
FRESHNESS_MAX_HOURS=24
# For demonstration only; normal, 429, 500 or timeout.
SELLER_API_SCENARIO=normal
SELLER_API_TIMEOUT_SECONDS=5
# Notifications require explicit user approval before enabling.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
